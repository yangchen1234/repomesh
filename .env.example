# Network defaults are loopback-only. For remote use, set an exact Tailscale/LAN IP.
# The supported launcher rejects 0.0.0.0/:: and requires a token for non-loopback binds.
REPOMESH_HOST=127.0.0.1
REPOMESH_PORT=8787
REPOMESH_DATA_DIR=data
# PowerShell accepts semicolon-separated roots; JSON arrays also work.
REPOMESH_REPOSITORY_ROOTS=["."]
# Generate a long random value outside Git. Never commit the populated .env file.
REPOMESH_API_TOKEN=

# Offline deterministic defaults make tests and lexical/vector evaluation reproducible.
# Set the three provider values below to ollama/ollama/qdrant for the real local stack.
REPOMESH_EMBEDDING_PROVIDER=fake
REPOMESH_EMBEDDING_MODEL=nomic-embed-text
REPOMESH_EMBEDDING_VERSION=latest
REPOMESH_EMBEDDING_DIMENSIONS=384
REPOMESH_GENERATION_PROVIDER=fake
REPOMESH_GENERATION_MODEL=qwen2.5-coder:1.5b
REPOMESH_VECTOR_PROVIDER=memory

REPOMESH_OLLAMA_URL=http://127.0.0.1:11434
REPOMESH_QDRANT_URL=http://127.0.0.1:6333
REPOMESH_QDRANT_COLLECTION=repomesh_chunks
REPOMESH_MAX_FILE_BYTES=1000000
REPOMESH_JOB_LEASE_SECONDS=30
REPOMESH_POSTGRES_DSN=postgresql://repomesh:repomesh@127.0.0.1:5432/repomesh
REPOMESH_POSTGRES_SCHEMA=repomesh
REPOMESH_JOB_HEARTBEAT_SECONDS=10
REPOMESH_JOB_POLL_SECONDS=1
REPOMESH_JOB_RETRY_BASE_SECONDS=1
REPOMESH_JOB_RETRY_MAX_SECONDS=60
REPOMESH_WORKER_OFFLINE_SECONDS=60
REPOMESH_JOB_MAX_RETRIES=3
REPOMESH_RRF_K=60
